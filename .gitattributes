# Shell scripts run on the Pi and must keep Unix line endings, even when
# checked out or zipped on Windows. Batch files need Windows line endings.
*.sh  text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Left out of the download that make-installer builds (developer files).
docs/ export-ignore
tests/ export-ignore
CLAUDE.md export-ignore
.gitattributes export-ignore
.gitignore export-ignore
make-installer.* export-ignore
manager/ export-ignore
build-manager.bat export-ignore
build-saver.bat export-ignore
dotnet-sdk.bat export-ignore
