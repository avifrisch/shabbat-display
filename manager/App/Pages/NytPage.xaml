<Page
    x:Class="ShabbatManager.Pages.NytPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="8" Padding="0,0,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="New York Times" Style="{StaticResource TitleTextBlockStyle}" />
            <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" HorizontalAlignment="Right" />
        </Grid>
        <InfoBar x:Name="Message" Grid.Row="1" IsClosable="True" />
        <StackPanel x:Name="Controls" Grid.Row="2" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Signed in, the display's reading panel shows whole NYT articles instead of the first paragraphs. The sign-in is sent only to nytimes.com." />
            <TextBlock x:Name="State" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource AccentButtonStyle}" Click="SignIn_Click" />
                <Button x:Name="SignOutButton" Content="Sign out" Click="SignOut_Click" />
            </StackPanel>
            <Expander Header="Sign-in page not working?" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap"
                               Text="In a browser signed in to nytimes.com, open Developer tools → Application → Cookies → nytimes.com and copy the value of NYT-S." />
                    <PasswordBox x:Name="Paste" PlaceholderText="NYT-S value" Width="360" HorizontalAlignment="Left" />
                    <Button Content="Save" Click="PasteSave_Click" />
                </StackPanel>
            </Expander>
        </StackPanel>
        <Grid x:Name="SignInView" Grid.Row="3" Visibility="Collapsed" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock VerticalAlignment="Center" Text="Sign in below. This closes by itself once you're signed in." />
                <Button Content="Cancel" Click="CancelSignIn_Click" />
            </StackPanel>
            <WebView2 x:Name="Web" Grid.Row="1" />
        </Grid>
    </Grid>
</Page>
