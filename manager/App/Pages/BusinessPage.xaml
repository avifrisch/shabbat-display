<Page
    x:Class="ShabbatManager.Pages.BusinessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer>
        <StackPanel Spacing="8" MaxWidth="760" HorizontalAlignment="Left" Padding="0,0,24,24">
            <Grid>
                <TextBlock Text="Business" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" IsEnabled="False" />
                </StackPanel>
            </Grid>
            <InfoBar x:Name="Message" IsClosable="True" />
            <ToggleSwitch x:Name="OnSwitch" Header="Business scene" OnContent="On" OffContent="Off" Toggled="Changed" />
            <TextBlock Text="Watchlist" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <StackPanel x:Name="Stocks" Spacing="2" />
            <AutoSuggestBox x:Name="StockSearch" PlaceholderText="Add a stock (ticker or company)" Width="360" HorizontalAlignment="Left"
                            TextChanged="StockSearch_TextChanged" SuggestionChosen="StockSearch_SuggestionChosen" />
            <TextBlock Text="Headlines" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <ToggleSwitch x:Name="NytSwitch" Header="New York Times Business" OnContent="Shown" OffContent="Hidden" Toggled="Changed" />
            <ToggleSwitch x:Name="CnbcSwitch" Header="CNBC" OnContent="Shown" OffContent="Hidden" Toggled="Changed" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"
                       Text="Prices are delayed. The first search downloads the SEC's list of companies." />
        </StackPanel>
    </ScrollViewer>
</Page>
