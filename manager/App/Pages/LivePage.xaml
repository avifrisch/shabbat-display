<Page
    x:Class="ShabbatManager.Pages.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid RowSpacing="8" Padding="0,0,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Live view" Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="ScreenPicker" AutomationProperties.Name="Which screen" MinWidth="220"
                      SelectionChanged="ScreenPicker_SelectionChanged" />
            <Button Content="Reload" Click="Reload_Click" />
            <Button Content="Open in browser" Click="OpenInBrowser_Click" />
        </StackPanel>
        <InfoBar x:Name="Message" Grid.Row="2" IsClosable="True" />
        <Border Grid.Row="3" CornerRadius="6" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="#0D1726">
            <controls:WebView2 x:Name="Web" AutomationProperties.Name="The display" />
        </Border>
    </Grid>
</Page>
