<Page
    x:Class="ShabbatManager.Pages.ShulPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="8" MaxWidth="820" HorizontalAlignment="Left" Padding="0,0,24,24">
            <Grid>
                <TextBlock Text="Shul" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                    <Button x:Name="UpdateButton" Content="Update now" Style="{StaticResource AccentButtonStyle}" Click="Update_Click" />
                </StackPanel>
            </Grid>
            <InfoBar x:Name="Message" IsClosable="True" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="The display downloads Bnai Yeshurun's weekly davening chart, the bulletin and the monthly calendar on its own: Fridays from noon until this Shabbat's bulletin is in. Update now checks the shul's site once." />
            <StackPanel x:Name="Rows" Spacing="12" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
