<ContentDialog
    x:Class="ShabbatManager.ConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Enter the access code"
    PrimaryButtonText="Connect"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="Connect_Click">
    <StackPanel Spacing="12" MinWidth="360">
        <TextBlock TextWrapping="Wrap" Text="The access code is printed at the end of setup on DESKTOP-H72VKDJ." />
        <PasswordBox x:Name="Code" PlaceholderText="Access code" />
        <TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="#E8615A" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
